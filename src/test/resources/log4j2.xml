<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test-only log4j configuration. Its real job is CLASSPATH POSITION, not logging
  policy: without it fabric-loader-junit classifies the mc114 game jar (which
  bundles its own log4j2.xml) as a system library and the test JVM fails with
  "couldn't locate the game". Do not delete. See docs/testing.md.
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="[%d{HH:mm:ss}] [%t/%level]: %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
