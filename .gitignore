.idea

# Eclipse / Eclipse JDT Language Server (VS Code Java, jdtls) write these into
# the repo root when they index the project — no build required. /bin/ holds
# compiled .class files and is NOT covered by the /build rule below. All four
# are root-anchored so a future src/**/bin/ resource dir is not swallowed.
/.classpath
/.project
/.settings/
/bin/
.gradle
/build
/forge/build
/forge/.gradle
/run
.worktrees/
build/e2e-logs/
docs/superpowers/
.superpowers/

# Written by the unit-test JVM: the test JVM's working directory is the repo root, so
# CommandsSpyConfig.load() creates a default commands-spy.json under <repo>/config, and
# log4j-core writes logs/latest.log. Neither is build output, so /build does not cover them.
/config/commands-spy.json
/logs/

# fabric-loader 0.19.3 writes its own log during fabric-loader-junit runs
fabricloader.log

# neoforge/ is a standalone Gradle build, so the root-anchored /build above does
# not cover its output tree - and that tree is multi-GB: ModDevGradle caches the
# decompiled and recompiled Minecraft under it.
neoforge/build/

# babric/ is a standalone Gradle build too, so the root-anchored /build above does
# not cover its output tree either. Same reason as neoforge/ and /forge/build.
babric/build/
